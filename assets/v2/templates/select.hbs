<header class="region-header region-header--select" data-region="header" data-type="select" data-pane-key="{{key}}">
    <div class="header-left">
        <label class="header-label" for="{{selectId}}">{{label}}</label>
        <select id="{{selectId}}" class="header-select" aria-label="{{label}}">
            {{#each options}}
            <option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>
            {{/each}}
        </select>
        {{#each extraButtons}}
        <button type="button" class="btn-header-action" data-header-action="{{action}}">
            {{#if icon}}<i class="bi {{icon}}" aria-hidden="true"></i>{{/if}}
            <span>{{text}}</span>
        </button>
        {{/each}}
    </div>
    <div class="header-right">
        <span class="header-file-pill">
            <i class="bi bi-filetype-json" aria-hidden="true"></i>
            <span id="{{fileNameId}}" class="header-file-name">{{fileName}}</span>
        </span>
    </div>
</header>
